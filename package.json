{
  "name": "vps-notifier",
  "version": "0.1.0",
  "description": "Get a Discord notification when an OVHcloud VPS comes back in stock, filtered by price and location. Runs on Cloudflare Workers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "catalog:update": "node --experimental-strip-types scripts/update-catalog.ts"
  },
  "keywords": [
    "ovh",
    "ovhcloud",
    "vps",
    "availability",
    "notifier",
    "discord",
    "cloudflare-workers"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
